        {
          "key": "code",
          "renderTypeList": [
            "custom"
          ],
          "label": "",
          "value": "function asObj(value){\n  if (!value) return {};\n  if (typeof value === 'object') return value;\n  try { return JSON.parse(String(value)); } catch { return {}; }\n}\nfunction arr(value){\n  if (Array.isArray(value)) return value.filter(Boolean);\n  if (value == null) return [];\n  if (typeof value === 'string') {\n    const s=value.trim();\n    if (!s || s === 'null' || s === 'undefined') return [];\n    try { const parsed=JSON.parse(s); return Array.isArray(parsed) ? parsed.filter(Boolean) : [parsed]; } catch { return [s]; }\n  }\n  return [value];\n}\nfunction textOf(value){ return value == null ? '' : String(value); }\nfunction hash(s){ let h=0; const t=String(s||''); for(let i=0;i<t.length;i++){ h=(Math.imul(31,h)+t.charCodeAt(i))|0; } return Math.abs(h).toString(36); }\nfunction now(){ return new Date().toISOString(); }\n\nfunction firstEvidence(pkg){\n  const ctx=asObj(pkg.context);\n  const facts=arr(ctx.facts);\n  const sourceMap=arr(ctx.sourceMap);\n  const f=facts[0] || {};\n  const s=sourceMap.find(x=>x.chunkId && x.chunkId===f.sourceChunkId) || sourceMap[0] || {};\n  if (!f.factId && !s.chunkId) return [];\n  return [{\n    evidenceId:f.factId || s.chunkId || 'manual_confirmation_required',\n    sourceChunkId:f.sourceChunkId || s.chunkId,\n    fileId:f.fileId || s.fileId,\n    fileName:s.fileName,\n    text:f.factText || s.excerpt || '需人工确认',\n    sourceBoundary:f.sourceBoundary || s.sourceBoundary || 'project_fact_only'\n  }];\n}\nfunction buildCandidate(pkg, check, index){\n  const item=asObj(pkg.reviewItem);\n  const evidence=firstEvidence(pkg);\n  const missingLike=/缺失|未提供|应包含|必须包含|required|missing/i.test(textOf(check.expectedContent));\n  return {\n    candidateId:`${pkg.packageId || 'PKG'}-CAND-${index+1}`,\n    title: check.expectedContent ? `需核查：${textOf(check.expectedContent).slice(0,40)}` : `需人工核查：${item.name || item.code || '审查项'}`,\n    issueName: check.expectedContent ? `需核查：${textOf(check.expectedContent).slice(0,40)}` : `需人工核查：${item.name || item.code || '审查项'}`,\n    issueType: missingLike ? 'missing_or_incomplete_content_candidate' : 'content_compliance_candidate',\n    riskHint:'medium',\n    riskLevel:'medium',\n    reviewResult:'需人工确认',\n    description: check.expectedContent || '当前目标 FastGPT 实例未证明支持 Parallel Run 内直接挂 AI Chat；本节点生成候选问题骨架并交由后续证据/合并/风险门禁处理。',\n    chapterLocation:'需人工确认',\n    remediation:'请结合 Review Wiki 事实、规则和原文证据人工确认。',\n    basis:[{basisId:check.sourceRuleId || 'manual_confirmation_required', text:check.expectedContent || '需人工确认'}],\n    evidence,\n    wikiTrace:[{wikiId:pkg.reviewWikiId, packageId:pkg.packageId, reviewItem:item.code || item.name, checkId:check.checkId || ''}],\n    absenceProof: missingLike ? {checkedScope:item.code || item.name || pkg.packageId, method:'expected_content_check', expectedContent:check.expectedContent || '', result:'requires_manual_confirmation'} : undefined,\n    sourceReviewItem:item.code || item.name || '',\n    manualConfirmationReason: evidence.length ? '候选问题需经 evidence_countercheck / issue_merge / risk_classification 硬门禁确认' : '缺少可自动绑定证据，需人工确认',\n    isFinalConclusion:false\n  };\n}\nfunction main({ currentItem, index }){\n  const pkg=asObj(currentItem);\n  const checks=arr(pkg.expectedContentChecks);\n  const candidates=(checks.length?checks:[{}]).slice(0,5).map((check,i)=>buildCandidate(pkg,check,i));\n  return { processed: JSON.stringify({ packageId:pkg.packageId, index, candidateIssues:candidates, degraded:true, requiresManualReview:true, executorMode:'parallel_code_body_import_safe', finalConclusionForbidden:true }) };\n}"
        }
