        {
          "key": "code",
          "renderTypeList": [
            "custom"
          ],
          "label": "",
          "value": "function asObj(value){\n  if (!value) return {};\n  if (typeof value === 'object') return value;\n  try { return JSON.parse(String(value)); } catch { return {}; }\n}\nfunction arr(value){\n  if (Array.isArray(value)) return value.filter(Boolean);\n  if (value == null) return [];\n  if (typeof value === 'string') {\n    const s=value.trim();\n    if (!s || s === 'null' || s === 'undefined') return [];\n    try { const parsed=JSON.parse(s); return Array.isArray(parsed) ? parsed.filter(Boolean) : [parsed]; } catch { return [s]; }\n  }\n  return [value];\n}\nfunction textOf(value){ return value == null ? '' : String(value); }\nfunction hash(s){ let h=0; const t=String(s||''); for(let i=0;i<t.length;i++){ h=(Math.imul(31,h)+t.charCodeAt(i))|0; } return Math.abs(h).toString(36); }\nfunction now(){ return new Date().toISOString(); }\n\nfunction normalizeRow(x){\n  const obj=asObj(x);\n  if (obj && obj.data) return asObj(obj.data);\n  if (obj && obj.output) return asObj(obj.output);\n  if (obj && obj.answerText) return asObj(obj.answerText);\n  if (obj && obj.processed) return asObj(obj.processed);\n  return obj;\n}\nfunction main({ successResults }){\n  const rows=arr(successResults).map(normalizeRow);\n  const candidateIssues=[];\n  rows.forEach((r,rowIndex)=>{\n    arr(r.candidateIssues).forEach((c,i)=>{\n      const riskLevel=c.riskLevel || c.riskHint || c.severityHint || 'medium';\n      candidateIssues.push({\n        ...c,\n        candidateId:c.candidateId || c.candidateIssueId || `PKG-${rowIndex+1}-CAND-${i+1}`,\n        issueName:c.issueName || c.title || '待人工确认问题',\n        riskLevel,\n        reviewResult:c.reviewResult || '需人工确认',\n        chapterLocation:c.chapterLocation || c.location || '需人工确认',\n        remediation:c.remediation || c.suggestion || '需人工确认',\n        basis:arr(c.basis).length?arr(c.basis):[{basisId:'manual_confirmation_required', text:'需人工确认'}],\n        manualConfirmationReason:c.manualConfirmationReason || (!arr(c.evidence).length ? '缺少可自动绑定证据，需人工确认' : ''),\n        sourceReviewItem:c.sourceReviewItem || c.reviewItem,\n        isFinalConclusion:false\n      });\n    });\n  });\n  return { candidateIssues, degraded:rows.some(r=>r.degraded), requiresManualReview:rows.some(r=>r.requiresManualReview), reviewExecutorPolicy:{outputs:'candidateIssues_only', finalConclusionForbidden:true, normalizedOutsideParallelRun:true} };\n}"
