        {
          "key": "code",
          "renderTypeList": [
            "custom"
          ],
          "label": "",
          "value": "function arr(value){\n  if (Array.isArray(value)) return value.filter(v => v !== undefined && v !== null && String(v).trim() !== '');\n  if (value == null) return [];\n  if (typeof value === 'string') {\n    const s = value.trim();\n    if (!s) return [];\n    try { const parsed = JSON.parse(s); return Array.isArray(parsed) ? parsed : [s]; } catch { return [s]; }\n  }\n  return [value];\n}\n\nfunction main({ items }){\n  const input = arr(items);\n  const itemArray = input.length ? input : ['alpha', 'beta', 'gamma'];\n  return { itemArray };\n}"
        }
      ],
