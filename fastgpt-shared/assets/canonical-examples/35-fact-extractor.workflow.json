          ],
          "label": "",
          "value": "js"
        },
        {
          "key": "code",
          "renderTypeList": [
            "custom"
          ],
          "label": "",
          "value": "function asObj(value){\n  if (!value) return {};\n  if (typeof value === 'object') return value;\n  try { return JSON.parse(String(value)); } catch { return {}; }\n}\nfunction arr(value){\n  if (Array.isArray(value)) return value.filter(Boolean);\n  if (value == null) return [];\n  if (typeof value === 'string') {\n    const s=value.trim();\n    if (!s || s === 'null' || s === 'undefined') return [];\n    try { const parsed=JSON.parse(s); return Array.isArray(parsed) ? parsed.filter(Boolean) : [parsed]; } catch { return [s]; }\n  }\n  return [value];\n}\nfunction textOf(value){ return value == null ? '' : String(value); }\nfunction hash(s){ let h=0; const t=String(s||''); for(let i=0;i<t.length;i++){ h=(Math.imul(31,h)+t.charCodeAt(i))|0; } return Math.abs(h).toString(36); }\nfunction now(){ return new Date().toISOString(); }\n\nfunction main({ chunks }){ return { chunkArray: arr(chunks).filter(c=>c.documentRole !== 'normative_basis').map(c=>JSON.stringify(c)) }; }"
        }
