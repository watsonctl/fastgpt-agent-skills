          "label": "",
          "value": "function main({ userChatInput, userFiles }) {\n  const reviewId = 'workflow-tool-call-probe-' + Date.now();\n  const targetFileUrls = Array.isArray(userFiles) ? userFiles.filter(Boolean) : [];\n  const candidateTitle = String(userChatInput || '').trim() || '工具工作流调用测试问题';\n\n  const reviewContext = {\n    reviewId,\n    documentType: 'construction_scheme',\n    documentTypeLabel: '施工方案',\n    query: candidateTitle,\n    targetFileUrls,\n    governedDatasetScope: {\n      profileId: 'probe.workflow_tool_call',\n      basisPackIds: [],\n      rulePackIds: []\n    },\n    evidenceRefIndex: {\n      'E-001': '用户输入 / 工具调用探针',\n      'F-001': targetFileUrls[0] || '未上传文件'\n    },\n    candidates: [\n      {\n        candidateId: 'support_material-candidate-001',\n        title: candidateTitle,\n        severityHint: 'medium',\n        moduleName: 'support_material',\n        summary: '这是主工作流调用工具工作流的最小 schema 探针，用于验证 pluginModule + pluginId + pluginInput/pluginOutput 映射。',\n        suggestion: '如本节点可正常返回 supportReviewResult，说明工具工作流调用链路有效。',\n        evidenceRefs: ['E-001'],\n        sourceRefs: ['F-001'],\n        evidenceStatus: targetFileUrls.length ? 'grounded' : 'visibility_gap',\n        manualReviewNeeded: !targetFileUrls.length,\n        findingType: 'schema_probe',\n        reportVisibility: 'formal',\n        ruleHits: [\n          {\n            ruleId: 'workflow_tool_call_schema_probe',\n            rationale: '主工作流已通过 pluginModule 调用证据材料整理工具工作流。'\n          }\n        ]\n      }\n    ]\n  };\n\n  return {\n    reviewContext,\n    reviewContextJson: JSON.stringify(reviewContext, null, 2)\n  };\n}",
          "debugLabel": "",
