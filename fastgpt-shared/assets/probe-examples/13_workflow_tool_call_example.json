          "label": "",
          "value": "function main({ userChatInput, userFiles }) {\n  const requestId = 'workflow-tool-call-probe-' + Date.now();\n  const targetFileUrls = Array.isArray(userFiles) ? userFiles.filter(Boolean) : [];\n  const candidateTitle = String(userChatInput || '').trim() || '工具工作流调用测试问题';\n\n  const toolInput = {\n    requestId,\n    taskType: 'generic_document',\n    taskTypeLabel: '通用文档',\n    query: candidateTitle,\n    targetFileUrls,\n    resourceScope: {\n      profileId: 'probe.workflow_tool_call',\n      resourceIds: [],\n      checkSetIds: []\n    },\n    inputRefIndex: {\n      'E-001': '用户输入 / 工具调用探针',\n      'F-001': targetFileUrls[0] || '未上传文件'\n    },\n    items: [\n      {\n        candidateId: 'sample_module-candidate-001',\n        title: candidateTitle,\n        priorityHint: 'medium',\n        moduleName: 'sample_module',\n        summary: '这是主工作流调用工具工作流的最小 schema 探针，用于验证 pluginModule + pluginId + pluginInput/pluginOutput 映射。',\n        suggestion: '如本节点可正常返回 toolResult，说明工具工作流调用链路有效。',\n        sourceRefs: ['E-001'],\n        sourceRefs: ['F-001'],\n        sourceStatus: targetFileUrls.length ? 'grounded' : 'visibility_gap',\n        humanReviewNeeded: !targetFileUrls.length,\n        itemType: 'schema_probe',\n        outputVisibility: 'final',\n        validationChecks: [\n          {\n            ruleId: 'workflow_tool_call_schema_probe',\n            rationale: '主工作流已通过 pluginModule 调用sample helper workflow tool。'\n          }\n        ]\n      }\n    ]\n  };\n\n  return {\n    toolInput,\n    toolInputJson: JSON.stringify(toolInput, null, 2)\n  };\n}",
          "debugLabel": "",
          "toolDescription": ""
        },
